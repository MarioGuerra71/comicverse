// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DataSource {
  COMICVINE
}

model Publisher {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  series     Series[]
  characters Character[]
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  libraryEntries UserComic[]
  readingHistory ReadingHistory[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Series {
  id          String     @id @default(uuid())
  publisherId String
  publisher   Publisher  @relation(fields: [publisherId], references: [id])
  name        String
  startYear   Int?
  source      DataSource
  externalId  String
  syncedAt    DateTime   @default(now())
  comics      Comic[]

  @@unique([source, externalId])
  @@index([publisherId])
}

model Comic {
  id            String           @id @default(uuid())
  seriesId      String
  series        Series           @relation(fields: [seriesId], references: [id])
  issueNumber   String?
  title         String
  storyTitle    String?
  description   String?
  releaseDate   DateTime?        @db.Date
  coverUrl      String?
  coverThumbUrl String?
  source        DataSource
  externalId    String
  syncedAt      DateTime         @default(now())
  characters    ComicCharacter[]
  creators      ComicCreator[]
  events        ComicEvent[]
  userEntries    UserComic[]
  readingHistory ReadingHistory[]

  @@unique([source, externalId])
  @@index([seriesId])
  @@index([releaseDate])
}

model Character {
  id                     String           @id @default(uuid())
  publisherId            String?
  publisher              Publisher?       @relation(fields: [publisherId], references: [id])
  name                   String
  realName               String?
  summary                String?
  imageUrl               String?
  imageThumbUrl          String?
  appearancesCount       Int?
  firstAppearanceExternalId String?
  isCollectible          Boolean          @default(false)
  source                 DataSource
  externalId             String
  syncedAt               DateTime         @default(now())
  detailsSyncedAt        DateTime?
  comics                 ComicCharacter[]

  @@unique([source, externalId])
  @@index([isCollectible])
  @@index([publisherId])
}

model ComicCharacter {
  comicId     String
  characterId String
  comic       Comic     @relation(fields: [comicId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([comicId, characterId])
  @@index([characterId])
}

model Creator {
  id         String         @id @default(uuid())
  name       String
  source     DataSource
  externalId String
  comics     ComicCreator[]

  @@unique([source, externalId])
}

model ComicCreator {
  comicId   String
  creatorId String
  roles     String
  comic     Comic   @relation(fields: [comicId], references: [id], onDelete: Cascade)
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([comicId, creatorId])
  @@index([creatorId])
}

model Event {
  id         String       @id @default(uuid())
  name       String
  source     DataSource
  externalId String
  comics     ComicEvent[]

  @@unique([source, externalId])
}

model ComicEvent {
  comicId String
  eventId String
  comic   Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([comicId, eventId])
  @@index([eventId])
}
enum ReadingStatus {
  PENDING
  READING
  READ
  DROPPED
}

model UserComic {
  userId     String
  comicId    String
  status     ReadingStatus @default(PENDING)
  isFavorite Boolean       @default(false)
  rating     Int?
  startedAt  DateTime?
  readAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic      Comic         @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@id([userId, comicId])
  @@index([userId, status])
  @@index([comicId])
}

model ReadingHistory {
  id         String         @id @default(uuid())
  userId     String
  comicId    String
  fromStatus ReadingStatus?
  toStatus   ReadingStatus?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic      Comic          @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([comicId])
}