// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DataSource {
  COMICVINE
}

model Publisher {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  series     Series[]
  characters Character[]
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  libraryEntries UserComic[]
  readingHistory ReadingHistory[]
  favoriteCharacters CharacterFavorite[]
  // Última visita a "Mi colección": lo descubierto después se marca como nuevo (dorado).
  collectionSeenAt   DateTime?
  discoveries        Discovery[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

// Contadores del límite de peticiones de Better Auth (storage: "database"): en Vercel hay
// varias instancias a la vez y la memoria no se comparte; PostgreSQL sí.
model RateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Series {
  id          String     @id @default(uuid())
  publisherId String
  publisher   Publisher  @relation(fields: [publisherId], references: [id])
  name        String
  startYear   Int?
  source      DataSource
  externalId  String
  syncedAt    DateTime   @default(now())
  comics      Comic[]

  @@unique([source, externalId])
  @@index([publisherId])
}

model Comic {
  id            String           @id @default(uuid())
  seriesId      String
  series        Series           @relation(fields: [seriesId], references: [id])
  issueNumber   String?
  title         String
  storyTitle    String?
  description   String?
  releaseDate   DateTime?        @db.Date
  coverUrl      String?
  coverThumbUrl String?
  source        DataSource
  externalId    String
  syncedAt      DateTime         @default(now())
  // Cuándo se trajo de Comic Vine la lista completa de personajes del cómic (null = nunca).
  charactersSyncedAt DateTime?
  characters    ComicCharacter[]
  creators      ComicCreator[]
  events        ComicEvent[]
  userEntries    UserComic[]
  readingHistory ReadingHistory[]
  discoveries    Discovery[]

  @@unique([source, externalId])
  @@index([seriesId])
  @@index([releaseDate])
}

model Character {
  id                     String           @id @default(uuid())
  publisherId            String?
  publisher              Publisher?       @relation(fields: [publisherId], references: [id])
  name                   String
  // Nombre para mostrar en las cartas (label curado de data/universe.json).
  displayName            String?
  // Número de catálogo fijo de la colección (orden de data/universe.json, no alfabético:
  // el número de un hueco bloqueado no debe dar pistas de quién es).
  catalogNumber          Int?             @unique
  realName               String?
  summary                String?
  imageUrl               String?
  imageThumbUrl          String?
  appearancesCount       Int?
  firstAppearanceExternalId String?
  isCollectible          Boolean          @default(false)
  source                 DataSource
  externalId             String
  syncedAt               DateTime         @default(now())
  detailsSyncedAt        DateTime?
  comics                 ComicCharacter[]
  relationshipsAsA       CharacterRelationship[] @relation("RelationshipA")
  relationshipsAsB       CharacterRelationship[] @relation("RelationshipB")
  favorites              CharacterFavorite[]
  discoveries            Discovery[]

  @@unique([source, externalId])
  @@index([isCollectible])
  @@index([publisherId])
}

model ComicCharacter {
  comicId     String
  characterId String
  comic       Comic     @relation(fields: [comicId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([comicId, characterId])
  @@index([characterId])
}

model Creator {
  id         String         @id @default(uuid())
  name       String
  source     DataSource
  externalId String
  comics     ComicCreator[]

  @@unique([source, externalId])
}

model ComicCreator {
  comicId   String
  creatorId String
  roles     String
  comic     Comic   @relation(fields: [comicId], references: [id], onDelete: Cascade)
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([comicId, creatorId])
  @@index([creatorId])
}

model Event {
  id         String       @id @default(uuid())
  name       String
  source     DataSource
  externalId String
  comics     ComicEvent[]

  @@unique([source, externalId])
}

model ComicEvent {
  comicId String
  eventId String
  comic   Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([comicId, eventId])
  @@index([eventId])
}
enum ReadingStatus {
  PENDING
  READING
  READ
  DROPPED
}

model UserComic {
  userId     String
  comicId    String
  status     ReadingStatus @default(PENDING)
  isFavorite Boolean       @default(false)
  rating     Int?
  startedAt  DateTime?
  readAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic      Comic         @relation(fields: [comicId], references: [id], onDelete: Cascade)
  review     Review?

  @@id([userId, comicId])
  @@index([userId, status])
  @@index([comicId])
}

// Reseña privada de un cómic de la biblioteca (una por usuario y cómic).
// Cuelga de UserComic: al quitar el cómic de la biblioteca, la reseña se borra con él.
model Review {
  userId    String
  comicId   String
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  entry     UserComic @relation(fields: [userId, comicId], references: [userId, comicId], onDelete: Cascade)

  @@id([userId, comicId])
  @@index([comicId])
}

model ReadingHistory {
  id         String         @id @default(uuid())
  userId     String
  comicId    String
  fromStatus ReadingStatus?
  toStatus   ReadingStatus?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic      Comic          @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([comicId])
}

// Relación curada entre dos personajes (data/relationships.json). Una fila por pareja:
// characterAId < characterBId (CHECK en la migración), así A–B y B–A no se duplican.
// type: texto validado en src/lib/relationship-types.ts.
model CharacterRelationship {
  characterAId String
  characterBId String
  type         String
  note         String?
  characterA   Character @relation("RelationshipA", fields: [characterAId], references: [id], onDelete: Cascade)
  characterB   Character @relation("RelationshipB", fields: [characterBId], references: [id], onDelete: Cascade)

  @@id([characterAId, characterBId])
  @@index([characterBId])
}

// Personajes favoritos de cada usuario (solo se pueden marcar desbloqueados).
model CharacterFavorite {
  userId      String
  characterId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([userId, characterId])
  @@index([characterId])
}

// Registro (solo crece) de cada vez que un usuario desbloquea un personaje, y con qué cómic.
// Es historia: si luego desmarca el cómic, la fila se queda (el estado actual se calcula aparte).
model Discovery {
  id          String    @id @default(uuid())
  userId      String
  characterId String
  viaComicId  String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  viaComic    Comic?    @relation(fields: [viaComicId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([characterId])
  @@index([viaComicId])
}
